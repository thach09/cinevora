# Disposable local/CI stack, isolated from cinevora_db and developer volumes.
COMPOSE_PROJECT_NAME=cinevora-ci
POSTGRES_CONTAINER_NAME=cinevora-ci-postgres
POSTGRES_VOLUME_NAME=cinevora_ci_pgdata
MEDIA_VOLUME_NAME=cinevora_ci_media
COMPOSE_NETWORK_NAME=cinevora-ci-net
POSTGRES_DB=cinevora_ci
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-ci-database-only
POSTGRES_PORT=15435
BACKEND_PORT=18086
FRONTEND_PORT=18088
CORS_ALLOWED_ORIGINS=http://localhost:18088
