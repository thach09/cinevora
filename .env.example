# =====================================================================
# CINEVORA - Environment template
# ---------------------------------------------------------------------
# Cach dung:
#   Copy-Item .env.example .env      (PowerShell / Windows)
#   cp .env.example .env             (bash / macOS / Linux)
#
# File .env KHONG duoc commit (da co trong .gitignore).
# Cac gia tri duoi day la mac dinh cho MOI TRUONG LOCAL - khong dung cho
# production. Phase 5 (DevOps) se quan ly secret bang bien moi truong
# cua platform deploy, khong dung file .env.
# =====================================================================

# --- PostgreSQL (docker compose) -------------------------------------
POSTGRES_DB=cinevora_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- JDBC URL cho backend Spring Boot (Phase 2) ----------------------
# Luu y: khi backend chay bang Docker Compose thi host la "postgres";
# khi chay truc tiep tren may host (IDE) thi host la "localhost".
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cinevora_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# --- Mat khau demo duoc bam (BCrypt) cho toan bo tai khoan seed -------
# V2__seed_data.sql chi chua hash, KHONG chua plaintext.
# Xem docs/database/seed-mapping.md muc "Demo credentials".
DEMO_PASSWORD=Cinevora@2026

# --- JWT (Phase 2 - khai bao truoc cho tien) -------------------------
# Bat buoc doi khi deploy that (>= 32 bytes, random).
JWT_SECRET=dev-only-secret-change-me-32-bytes-minimum
JWT_EXPIRATION_SECONDS=86400

# --- Backend CORS ----------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
